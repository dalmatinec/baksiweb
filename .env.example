# ==== Baksi Cloud ====
# Токен хаб-бота (главного бота платформы) из @BotFather
HUB_BOT_TOKEN=
# Запасной хаб-бот (второй бот из @BotFather). Если Telegram заблокирует основной, платформа сама
# переключится на запасной и разошлёт всем новую ссылку. Сделайте ему /setdomain baksi.cloud
HUB_BOT_TOKEN_RESERVE=
# Ваш Telegram ID (узнать: @userinfobot). Несколько владельцев - через запятую
OWNER_IDS=
# Ключ шифрования токенов клиентов. Сгенерировать: openssl rand -hex 32
# ХРАНИТЕ ОТДЕЛЬНО: без него токены из бэкапа не расшифровать
SECRET_KEY=
# Название платформы
BRAND=Baksi Cloud

# Домен сайта с https (включает веб-кабинет, Mini App и вход по ссылке). Пусто - работает только бот
PUBLIC_URL=
# Только для docker compose с Caddy: домен без https://
DOMAIN=

# Оплата: токен Crypto Pay из @CryptoBot → Crypto Pay → Create App
CRYPTOPAY_TOKEN=
# 1 - тестовая сеть (@CryptoTestnetBot)
CRYPTOPAY_TESTNET=0

# Прокси до Telegram, если сервер не достаёт напрямую: socks5://host:port
PROXY_URL=

# Лимиты и хранение
# Лимит памяти одной копии бота, если модуль не задал свой (считается реальная память, PSS)
INSTANCE_MEM_MB=320
MAX_INSTANCES=300
# Боты запускаются через общую заготовку: в ~5 раз меньше памяти. 0 - обычный запуск
USE_ZYGOTE=1
# Сколько полных бэкапов хранить на сервере (копии - в Telegram-канале бэкапов)
BACKUP_KEEP=1
PURGE_AFTER_DAYS=30
LOG_LEVEL=INFO
# Часовой пояс сервера (ночной бэкап в 04:00 по нему)
TZ=Asia/Almaty
